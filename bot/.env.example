# Cấu hình cho bot chạy local. Copy thành .env rồi điền:
#   cp bot/.env.example .env
# KHÔNG commit file .env (đã nằm trong .gitignore).

# Lấy từ @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Chat ID của bạn. Cách lấy: nhắn bot bất kỳ, mở
# https://api.telegram.org/bot<TOKEN>/getUpdates và tìm "chat":{"id": ...
TELEGRAM_CHAT_ID=123456789

# Tuỳ chọn
IDF_PATH=/opt/esp/idf
IDF_VERSION=v5.1.4
# Local nhanh hơn CI nên không cần idle-timeout ngắn
IDLE_EXIT_MINUTES=120
CCACHE_MAXSIZE=2G